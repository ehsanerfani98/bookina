{
  "manifest_version": 3,
  "name": "بوکینا",
  "version": "2.0.0",
  "description": "داشبورد شخصی فارسی برای تب جدید — تقویم شمسی، آب‌وهوا، تسک‌ها، عادت‌ها، پومودورو، بوکمارک‌ها، اخبار و نرخ ارز",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://call1.tgju.org/*",
    "https://api.rss2json.com/*",
    "https://www.google.com/s2/favicons*",
    "https://*.zoomit.ir/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
